{
  "manifest_version": 3,
  "name": "RecordHub - WhatsApp Web Call Tracker",
  "description": "Automatically detects and logs WhatsApp Web calls to the RecordHub dashboard. Captures call metadata and audio recordings for compliance tracking.",
  "version": "1.0.2",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "tabCapture",
    "offscreen"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "https://*.vercel.app/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["inpage.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["inpage.js"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ]
}
